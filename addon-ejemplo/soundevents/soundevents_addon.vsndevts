{
	// "csgo_mega": same volume wherever the player is (best for !psall / !psto)
	"sounds.alert" =
	{
		type = "csgo_mega"
		vsnd_files_track_01 = "sounds/playsounds/alert.vsnd"
		volume = 1.0
	}
	"sounds.alarm" =
	{
		type = "csgo_mega"
		vsnd_files_track_01 = "sounds/playsounds/alarm.vsnd"
		volume = 1.0
	}

	// "csgo_3d": fades with distance (best for !psat)
	"sounds.steps" =
	{
		type = "csgo_3d"
		vsnd_files_track_01 = "sounds/playsounds/steps.vsnd"
		volume = 1.0
		distance_max = 800.0
	}

	// Radio songs: "csgo_mega" so they sound the same anywhere
	"radio.song1" =
